NODE_ENV=development
PORT=3001

# PostgreSQL 18 — no guardes la contraseña en el repositorio.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/hilo_vivo
DATABASE_SSL=false

# URL pública del frontend (Netlify o localhost).
CLIENT_URL=http://localhost:5173
PUBLIC_URL=http://localhost:3001

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-your-token
MERCADO_PAGO_WEBHOOK_SECRET=your-webhook-secret
